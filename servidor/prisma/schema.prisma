// Fonte unica do modelo fisico (docs/01, secao 7). O DER e o dicionario de
// dados sao gerados daqui, e nao desenhados a parte.
//
// Regra de mapeamento: tabela em snake_case; colunas com os nomes de
// compartilhado/src/tipos.ts; DateTime -> timestamptz(3); Date -> date;
// enumeracao -> enum do PostgreSQL; atributo [1..*] -> array com CHECK de pelo
// menos um elemento. As faixas fechadas e a imutabilidade estao na migracao,
// porque o Prisma nao as expressa aqui.

generator client {
  provider            = "prisma-client"
  output              = "../src/gerado"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Enumeracoes

enum Perfil {
  TERAPEUTA
  COORDENADOR
  ADMINISTRADOR
  RESPONSAVEL
  PROFESSOR

  @@map("perfil")
}

/// Sem SEM_PLANO: e estado da tela para quem ainda nao tem plano, e nao a
/// situacao de um plano que existe (tipos.ts usa Exclude<SituacaoPlano, 'SEM_PLANO'>).
enum SituacaoPlano {
  RASCUNHO
  AGUARDANDO_VALIDACAO
  DEVOLVIDO
  VIGENTE

  @@map("situacao_plano")
}

enum StatusObjetivo {
  NAO_INICIADO
  EM_AQUISICAO
  DOMINADO

  @@map("status_objetivo")
}

enum Resultado {
  INDEPENDENTE
  AJUDA_GESTUAL
  AJUDA_FISICA
  SEM_RESPOSTA

  @@map("resultado")
}

enum SituacaoSessao {
  AGENDADA
  EM_ANDAMENTO
  PAUSADA
  ENCERRADA
  CANCELADA

  @@map("situacao_sessao")
}

enum StatusSync {
  PENDENTE
  SINCRONIZADO

  @@map("status_sync")
}

enum Origem {
  CLINICA
  CASA
  ESCOLA

  @@map("origem")
}

enum Destinatario {
  PROFISSIONAIS
  FAMILIA

  @@map("destinatario")
}

enum Desempenho {
  SOZINHO
  COM_AJUDA
  NAO_QUIS

  @@map("desempenho")
}

enum EscopoAcesso {
  CARTAO_ESTRATEGIA
  REGISTRO_OCORRENCIA

  @@map("escopo_acesso")
}

enum StatusVinculo {
  ATIVO
  ENCERRADO

  @@map("status_vinculo")
}

enum AcaoAuditoria {
  CONCESSAO_ACESSO
  REVOGACAO_ACESSO
  LEITURA_AUTORIZADA
  ACESSO_NEGADO
  CRIACAO
  ALTERACAO

  @@map("acao_auditoria")
}

enum OrigemAuditoria {
  CLINICA
  FAMILIA
  ESCOLA
  SISTEMA

  @@map("origem_auditoria")
}

// ---------------------------------------------------------------- Usuarios
// Tabela por subclasse: a chave de profissional, responsavel e professor_aee
// e o proprio usuarioId, que e tambem chave estrangeira para usuario.

model Usuario {
  id             String    @id @default(uuid(7)) @db.Uuid
  nome           String
  email          String    @unique
  /// Nunca trafega: nenhum tipo de compartilhado/ o carrega.
  senhaHash      String
  perfis         Perfil[]
  ativo          Boolean
  ultimoAcessoEm DateTime? @db.Timestamptz(3)

  profissional       Profissional?
  responsavel        Responsavel?
  professorAee       ProfessorAEE?
  registrosAuditoria RegistroAuditoria[]
  sessoesLogin       SessaoLogin[]
  acessosIniciais    AcessoInicial[]

  @@map("usuario")
}

/// Sessao de login (docs/07, D5): no banco, e nao na memoria do processo — o
/// Render reinicia o servico quando quer. O cookie leva o token; aqui fica so
/// o resumo SHA-256 dele, para que uma copia do banco nao abra sessao nenhuma.
/// Infraestrutura de autenticacao, e nao classe do dominio: fica fora do
/// diagrama de classes.
model SessaoLogin {
  id          String   @id @default(uuid(7)) @db.Uuid
  tokenResumo String   @unique
  usuarioId   String   @db.Uuid
  perfilAtivo Perfil
  criadaEm    DateTime @db.Timestamptz(3)
  /// Renovada com o uso; vencida, a sessao nao vale e a linha e apagada.
  expiraEm    DateTime @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@map("sessao_login")
}

/// Link de primeiro acesso (docs/07, secao 0, lacuna 1): uso unico, 72 horas.
/// So o resumo SHA-256 do token: o link existe uma vez, na mao de quem cadastra.
model AcessoInicial {
  id          String    @id @default(uuid(7)) @db.Uuid
  tokenResumo String    @unique
  usuarioId   String    @db.Uuid
  criadoEm    DateTime  @db.Timestamptz(3)
  expiraEm    DateTime  @db.Timestamptz(3)
  usadoEm     DateTime? @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@map("acesso_inicial")
}

model Profissional {
  usuarioId        String @id @db.Uuid
  especialidade    String
  registroConselho String

  usuario           Usuario            @relation(fields: [usuarioId], references: [id])
  pacientesDoCaso   Paciente[]         @relation("ResponsavelPeloCaso")
  equipes           EquipePaciente[]
  sessoesConduzidas Sessao[]
  planosDeQueEAutor PlanoTerapeutico[]

  @@map("profissional")
}

model Responsavel {
  usuarioId String @id @db.Uuid
  telefone  String

  usuario        Usuario                 @relation(fields: [usuarioId], references: [id])
  vinculos       VinculoFamiliar[]
  consentimentos Consentimento[]
  execucoes      ExecucaoAtividadeCasa[]

  @@map("responsavel")
}

model ProfessorAEE {
  usuarioId String @id @db.Uuid

  usuario     Usuario             @relation(fields: [usuarioId], references: [id])
  vinculos    VinculoEscolar[]
  ocorrencias OcorrenciaEscolar[]

  @@map("professor_aee")
}

// ---------------------------------------------------------------- Clinica

model Paciente {
  id                        String   @id @default(uuid(7)) @db.Uuid
  nome                      String
  dataNascimento            DateTime @db.Date
  /// CHECK 1..3 na migracao.
  nivelSuporte              Int
  profissionalResponsavelId String   @db.Uuid
  ativo                     Boolean

  profissionalResponsavel Profissional               @relation("ResponsavelPeloCaso", fields: [profissionalResponsavelId], references: [usuarioId])
  equipe                  EquipePaciente[]
  vinculosFamiliares      VinculoFamiliar[]
  sessoes                 Sessao[]
  planos                  PlanoTerapeutico[]
  ocorrencias             OcorrenciaComportamental[]
  atividades              AtividadeCasa[]
  relatorios              RelatorioEvolucao[]
  consentimentos          Consentimento[]
  vinculosEscolares       VinculoEscolar[]
  ocorrenciasEscolares    OcorrenciaEscolar[]

  @@map("paciente")
}

/// Associacao "equipe" (Paciente *-1..* Profissional): o equipeIds de tipos.ts.
model EquipePaciente {
  pacienteId     String @db.Uuid
  profissionalId String @db.Uuid

  paciente     Paciente     @relation(fields: [pacienteId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [usuarioId])

  @@id([pacienteId, profissionalId])
  @@index([profissionalId])
  @@map("paciente_equipe")
}

model VinculoFamiliar {
  id               String  @id @default(uuid(7)) @db.Uuid
  responsavelId    String  @db.Uuid
  pacienteId       String  @db.Uuid
  parentesco       String
  responsavelLegal Boolean

  responsavel Responsavel @relation(fields: [responsavelId], references: [usuarioId])
  paciente    Paciente    @relation(fields: [pacienteId], references: [id])

  @@index([responsavelId])
  @@index([pacienteId])
  @@map("vinculo_familiar")
}

model Sessao {
  id               String         @id @default(uuid(7)) @db.Uuid
  pacienteId       String         @db.Uuid
  profissionalId   String         @db.Uuid
  numero           Int
  inicioPrevistoEm DateTime       @db.Timestamptz(3)
  inicio           DateTime?      @db.Timestamptz(3)
  fim              DateTime?      @db.Timestamptz(3)
  local            String
  situacao         SituacaoSessao
  statusSync       StatusSync
  /// Registro documental da sessao (Resolucao CFP 001/2009), escrito pelo
  /// profissional ao encerrar. CHECK na migracao: preenchida se, e somente
  /// se, a sessao esta encerrada.
  evolucao         String?

  paciente     Paciente                   @relation(fields: [pacienteId], references: [id])
  profissional Profissional               @relation(fields: [profissionalId], references: [usuarioId])
  registros    RegistroAtividade[]
  ocorrencias  OcorrenciaComportamental[]

  /// Alvo da chave composta de ocorrencia_comportamental.
  @@unique([id, pacienteId])
  @@index([pacienteId])
  @@index([profissionalId, inicioPrevistoEm])
  @@map("sessao")
}

/// Composicao: o registro nao existe sem a sessao.
model RegistroAtividade {
  id         String    @id @default(uuid(7)) @db.Uuid
  sessaoId   String    @db.Uuid
  objetivoId String    @db.Uuid
  ordem      Int
  resultado  Resultado
  ocorridoEm DateTime  @db.Timestamptz(3)

  /// Restrict, e nao Cascade: prontuario nao se apaga, nem em cascata.
  sessao   Sessao   @relation(fields: [sessaoId], references: [id], onDelete: Restrict)
  objetivo Objetivo @relation(fields: [objetivoId], references: [id])

  @@index([sessaoId])
  @@index([objetivoId])
  @@map("registro_atividade")
}

model PlanoTerapeutico {
  id                  String        @id @default(uuid(7)) @db.Uuid
  pacienteId          String        @db.Uuid
  autorId             String        @db.Uuid
  status              SituacaoPlano
  dataInicio          DateTime      @db.Date
  dataRevisao         DateTime      @db.Date
  ultimaRevisaoEm     DateTime?     @db.Timestamptz(3)
  observacaoValidacao String?

  paciente  Paciente     @relation(fields: [pacienteId], references: [id])
  autor     Profissional @relation(fields: [autorId], references: [usuarioId])
  objetivos Objetivo[]

  @@index([pacienteId])
  @@map("plano_terapeutico")
}

/// Composicao: o objetivo nao existe sem o plano. CriterioDominio, objeto de
/// valor sem identidade, vira as duas ultimas colunas.
model Objetivo {
  id                  String         @id @default(uuid(7)) @db.Uuid
  planoId             String         @db.Uuid
  dominio             String
  descricaoTecnica    String
  descricaoAcessivel  String
  status              StatusObjetivo
  dominadoEm          DateTime?      @db.Timestamptz(3)
  /// CHECK 0..100 na migracao.
  percentualAtual     Decimal        @db.Decimal(5, 2)
  /// CriterioDominio. CHECK 0..100 na migracao.
  percentualMinimo    Int
  /// CriterioDominio.
  sessoesConsecutivas Int

  /// Restrict, e nao Cascade: apagar o plano nao leva os objetivos junto.
  plano      PlanoTerapeutico    @relation(fields: [planoId], references: [id], onDelete: Restrict)
  registros  RegistroAtividade[]
  atividades AtividadeCasa[]
  cartoes    CartaoEstrategia[]

  @@index([planoId])
  @@map("objetivo")
}

model OcorrenciaComportamental {
  id                  String    @id @default(uuid(7)) @db.Uuid
  pacienteId          String    @db.Uuid
  origem              Origem
  ocorridaEm          DateTime  @db.Timestamptz(3)
  antecedente         String
  comportamento       String
  consequencia        String
  /// CHECK 1..5 na migracao.
  intensidade         Int
  leituraClinicaEm    DateTime? @db.Timestamptz(3)
  sessaoId            String?   @db.Uuid
  /// A ocorrencia da escola que a gerou («gera»), quando veio de la.
  ocorrenciaEscolarId String?   @unique @db.Uuid

  paciente          Paciente           @relation(fields: [pacienteId], references: [id])
  /// Composta: a sessao tem de ser do mesmo paciente. Nas cinco compostas, a
  /// atualizacao e Restrict: com Cascade, trocar o paciente do alvo levaria
  /// esta linha junto, em silencio, para outro paciente.
  sessao            Sessao?            @relation(fields: [sessaoId, pacienteId], references: [id, pacienteId], onDelete: Restrict, onUpdate: Restrict)
  /// Composta: a ocorrencia da escola que a gerou tem de ser do mesmo paciente.
  ocorrenciaEscolar OcorrenciaEscolar? @relation(fields: [ocorrenciaEscolarId, pacienteId], references: [id, pacienteId], onDelete: Restrict, onUpdate: Restrict)

  /// Exigido pelo Prisma para a relacao 1-0..1 composta com a ocorrencia da
  /// escola. Ja vale por ocorrenciaEscolarId ser unico sozinho.
  @@unique([ocorrenciaEscolarId, pacienteId])
  @@index([pacienteId, ocorridaEm])
  @@map("ocorrencia_comportamental")
}

/// Documento clinico emitido: so cresce (trigger na migracao).
model RelatorioEvolucao {
  id              String       @id @default(uuid(7)) @db.Uuid
  pacienteId      String       @db.Uuid
  /// Fotografia dos objetivos abrangidos, sem chave estrangeira: o documento
  /// emitido nao muda quando o plano muda.
  objetivoIds     String[]     @db.Uuid
  periodoInicio   DateTime     @db.Date
  periodoFim      DateTime     @db.Date
  destinatario    Destinatario
  consideracoes   String
  /// Fotografia do autor, sem chave estrangeira.
  autorNome       String
  /// Fotografia do autor, sem chave estrangeira.
  autorRegistro   String
  emitidoEm       DateTime     @db.Timestamptz(3)
  /// O JSON canonico exato que foi resumido em hashConteudo. Texto, e nunca
  /// jsonb: o jsonb reescreve o texto, e o documento precisa sair igual.
  conteudoEmitido String
  hashConteudo    String

  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId, emitidoEm])
  @@map("relatorio_evolucao")
}

// ---------------------------------------------------------------- Familia

model AtividadeCasa {
  id                String   @id @default(uuid(7)) @db.Uuid
  pacienteId        String   @db.Uuid
  objetivoId        String   @db.Uuid
  titulo            String
  descricao         String
  passos            String[]
  dicas             String
  frequenciaSemanal Int
  urlVideo          String?
  ativa             Boolean
  prescritaEm       DateTime @db.Timestamptz(3)

  paciente  Paciente                @relation(fields: [pacienteId], references: [id])
  objetivo  Objetivo                @relation(fields: [objetivoId], references: [id])
  execucoes ExecucaoAtividadeCasa[]

  @@index([pacienteId])
  @@map("atividade_casa")
}

model ExecucaoAtividadeCasa {
  id             String     @id @default(uuid(7)) @db.Uuid
  atividadeId    String     @db.Uuid
  responsavelId  String     @db.Uuid
  dataRealizacao DateTime   @db.Date
  desempenho     Desempenho
  observacao     String?

  atividade   AtividadeCasa @relation(fields: [atividadeId], references: [id])
  responsavel Responsavel   @relation(fields: [responsavelId], references: [usuarioId])

  @@index([atividadeId])
  @@map("execucao_atividade_casa")
}

// ---------------------------------------------------------------- Escola

model CartaoEstrategia {
  id            String   @id @default(uuid(7)) @db.Uuid
  objetivoId    String   @db.Uuid
  tituloSimples String
  oQueFazer     String[]
  oQueEvitar    String[]
  sinalAlerta   String
  atualizadoEm  DateTime @db.Timestamptz(3)

  objetivo Objetivo @relation(fields: [objetivoId], references: [id])

  @@index([objetivoId])
  @@map("cartao_estrategia")
}

model Escola {
  id        String @id @default(uuid(7)) @db.Uuid
  nome      String
  rede      String
  municipio String

  consentimentos Consentimento[]

  @@map("escola")
}

/// A situacao (vigente, revogado, expirado) nao e coluna: deriva das datas, a
/// cada leitura (regra 5).
model Consentimento {
  id            String         @id @default(uuid(7)) @db.Uuid
  responsavelId String         @db.Uuid
  pacienteId    String         @db.Uuid
  escolaId      String         @db.Uuid
  escopos       EscopoAcesso[]
  concedidoEm   DateTime       @db.Timestamptz(3)
  validadeAte   DateTime       @db.Date
  revogadoEm    DateTime?      @db.Timestamptz(3)
  hashTermo     String

  responsavel Responsavel      @relation(fields: [responsavelId], references: [usuarioId])
  paciente    Paciente         @relation(fields: [pacienteId], references: [id])
  escola      Escola           @relation(fields: [escolaId], references: [id])
  convites    ConviteEscolar[]
  vinculos    VinculoEscolar[]

  /// Alvo da chave composta de vinculo_escolar.
  @@unique([id, pacienteId])
  @@index([pacienteId])
  @@map("consentimento")
}

model ConviteEscolar {
  id              String    @id @default(uuid(7)) @db.Uuid
  consentimentoId String    @db.Uuid
  /// So o resumo SHA-256 do token, como no acesso inicial: o link leva o
  /// token, e o banco nunca o ve (revisao de 16/10).
  tokenResumo     String    @unique
  criadoEm        DateTime  @db.Timestamptz(3)
  expiraEm        DateTime  @db.Timestamptz(3)
  usadoEm         DateTime? @db.Timestamptz(3)

  consentimento Consentimento   @relation(fields: [consentimentoId], references: [id])
  vinculo       VinculoEscolar?

  /// Alvo da chave composta de vinculo_escolar.
  @@unique([id, consentimentoId])
  @@index([consentimentoId])
  @@map("convite_escolar")
}

model VinculoEscolar {
  id              String        @id @default(uuid(7)) @db.Uuid
  consentimentoId String        @db.Uuid
  /// ConviteEscolar 1-0..1 VinculoEscolar: um convite gera no maximo um vinculo.
  conviteId       String        @unique @db.Uuid
  pacienteId      String        @db.Uuid
  professorId     String        @db.Uuid
  turma           String
  turno           String
  atuacao         String
  status          StatusVinculo

  /// Composta: o consentimento tem de ser deste paciente.
  consentimento Consentimento       @relation(fields: [consentimentoId, pacienteId], references: [id, pacienteId], onUpdate: Restrict)
  /// Composta: o convite tem de ser deste consentimento.
  convite       ConviteEscolar      @relation(fields: [conviteId, consentimentoId], references: [id, consentimentoId], onUpdate: Restrict)
  paciente      Paciente            @relation(fields: [pacienteId], references: [id])
  professor     ProfessorAEE        @relation(fields: [professorId], references: [usuarioId])
  ocorrencias   OcorrenciaEscolar[]

  /// Alvo da chave composta de ocorrencia_escolar.
  @@unique([id, pacienteId, professorId])
  /// Exigido pelo Prisma para a relacao 1-0..1 composta com o convite. Ja vale
  /// por conviteId ser unico sozinho: nao restringe nada a mais.
  @@unique([conviteId, consentimentoId])
  @@index([professorId, pacienteId])
  @@map("vinculo_escolar")
}

model OcorrenciaEscolar {
  id           String    @id @default(uuid(7)) @db.Uuid
  vinculoId    String    @db.Uuid
  pacienteId   String    @db.Uuid
  professorId  String    @db.Uuid
  ocorridoEm   DateTime  @db.Timestamptz(3)
  registradaEm DateTime  @db.Timestamptz(3)
  corrigidaEm  DateTime? @db.Timestamptz(3)
  tipo         String
  /// CHECK 1..5 na migracao.
  intensidade  Int
  contexto     String

  /// Composta: o vinculo tem de ser deste paciente e deste professor.
  vinculo          VinculoEscolar            @relation(fields: [vinculoId, pacienteId, professorId], references: [id, pacienteId, professorId], onUpdate: Restrict)
  paciente         Paciente                  @relation(fields: [pacienteId], references: [id])
  professor        ProfessorAEE              @relation(fields: [professorId], references: [usuarioId])
  ocorrenciaGerada OcorrenciaComportamental?

  /// Alvo da chave composta de ocorrencia_comportamental.
  @@unique([id, pacienteId])
  @@map("ocorrencia_escolar")
}

// ---------------------------------------------------------------- Auditoria

/// So cresce (trigger na migracao). usuarioNome e perfil sao fotografia do
/// momento; pacienteId e idEntidade sao referencias, sem chave estrangeira,
/// porque o registro precisa sobreviver ao que ele registra.
model RegistroAuditoria {
  id            String          @id @default(uuid(7)) @db.Uuid
  ocorridoEm    DateTime        @db.Timestamptz(3)
  usuarioId     String?         @db.Uuid
  usuarioNome   String?
  perfil        Perfil?
  acao          AcaoAuditoria
  entidade      String
  idEntidade    String?         @db.Uuid
  pacienteId    String?         @db.Uuid
  origem        OrigemAuditoria
  ipOrigem      String?
  detalhe       String
  valorAnterior String?

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([pacienteId, ocorridoEm])
  @@index([usuarioId])
  @@map("registro_auditoria")
}
