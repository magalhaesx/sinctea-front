{
  "name": "@sinctea/servidor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Servidor do SINCTEA (NestJS) — docs/07",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "banco": "node scripts/banco.mjs",
    "build": "npm run build -w @sinctea/compartilhado && prisma generate && tsc -p tsconfig.json && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "semente": "node dist/prisma/semente.js",
    "criar-administrador": "npm run build && node dist/src/comandos/criar-administrador.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sinctea/compartilhado": "*",
    "argon2": "0.45.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@swc/core": "1.16.18",
    "@types/node": "^22.10.0",
    "embedded-postgres": "17.10.0-beta.17",
    "prisma": "7.10.0",
    "unplugin-swc": "2.0.0"
  }
}
