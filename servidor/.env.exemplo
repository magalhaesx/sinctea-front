# Copie para servidor/.env, que fica fora do git.

# O banco embutido de `npm run banco -w @sinctea/servidor`. So na maquina de
# desenvolvimento: usuario e senha valem apenas para esse PostgreSQL local.
DATABASE_URL=postgresql://sinctea:sinctea@localhost:54329/sinctea

# Senha das contas de demonstracao, gravada como hash argon2id pela semente.
# Vazia, a semente se recusa a rodar. Nunca a commite preenchida.
SENHA_SEMENTE=
