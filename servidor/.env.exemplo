# Copie para servidor/.env, que fica fora do git.

# O banco embutido de `npm run banco -w @sinctea/servidor`. So na maquina de
# desenvolvimento: usuario e senha valem apenas para esse PostgreSQL local.
DATABASE_URL=postgresql://sinctea:sinctea@localhost:54329/sinctea

# Banco-sombra, so para gerar migracao nova com:
#   npx prisma migrate diff --from-migrations prisma/migracoes \
#     --to-schema prisma/schema.prisma --script
# O Prisma o apaga e recria a cada uso: nunca aponte para um banco com dados.
SHADOW_DATABASE_URL=postgresql://sinctea:sinctea@localhost:54329/sinctea_sombra

# Opcional: o Nest serve o build do front (npm run build, na raiz) em "/".
# Sem ela, so a API; no desenvolvimento, o front e o Vite. Na imagem Docker, o
# Dockerfile a define.
# PASTA_DO_FRONT=../dist

# Senha das contas de demonstracao, gravada como hash argon2id pela semente.
# Vazia, a semente se recusa a rodar. Nunca a commite preenchida.
SENHA_SEMENTE=
