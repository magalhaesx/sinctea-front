{
  "name": "sinctea-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Front-end do SINCTEA — Sistema Integrado de Continuidade Terapeutica no TEA",
  "scarfSettings": {
    "enabled": false
  },
  "workspaces": [
    "compartilhado",
    "servidor"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:servidor": "npm run build -w @sinctea/servidor",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cobertura": "vitest run --coverage && node verificacao/resumo-cobertura.mjs",
    "verificar:navegador": "playwright test"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@sinctea/compartilhado": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "fake-indexeddb": "6.2.7",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
