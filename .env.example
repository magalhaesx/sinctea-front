# Para o front falar com a API local, copie para .env.api (ignorado pelo git),
# com VITE_API_URL=/api, e rode: npm run dev -- --mode api
# Nao use .env.local: ele vale tambem nos testes do front, que precisam do mock.

# Endereco da API real. Vazio, a implementacao simulada.
VITE_API_URL=

# So para a implementacao simulada: probabilidade de falha, de 0 a 1.
# 0.1 faz 10% das chamadas falharem; use para exercitar os estados de erro.
VITE_MOCK_FALHA=0
